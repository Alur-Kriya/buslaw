---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/contact/ContactForm';
import { firmContact } from '../data/navigation';
---

<PageLayout
  title="Hubungi Kami & Jadwalkan Konsultasi | BUSLAW & PARTNERS"
  description="Hubungi kantor pusat Buslaw & Partners di SCBD Jakarta Selatan. Konsultasikan perkara bisnis, litigasi komersial, atau kebutuhan hukum Anda."
  headerTitle="Hubungi & Kunjungi Kantor Kami"
  headerSubtitle="Tim kami siap menyambut Anda di Equity Tower SCBD Jakarta Selatan atau mengadakan sesi konsultasi virtual yang aman dan terenkripsi."
  breadcrumbs={[{ label: 'Kontak' }]}
>
  <section class="py-20 bg-[#FAF8F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Left: Interactive Form (7 cols) -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>

        <!-- Right: Office Address, Map & Details (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Main Office Card (Preline Card) -->
          <div class="flex flex-col bg-white border border-slate-200 shadow-xs rounded-xl p-6 sm:p-8 space-y-6">
            <div class="border-b border-slate-100 pb-4">
              <span class="inline-flex items-center gap-x-1.5 py-1 px-3 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#C8A961]/15 text-[#B19047] border border-[#C8A961]/30">
                <span class="size-1.5 rounded-full bg-[#C8A961]"></span>
                <span>Kantor Pusat Jakarta</span>
              </span>
              <h3 class="text-2xl font-bold text-[#0F1E36] font-serif mt-2">BUSLAW & PARTNERS</h3>
            </div>

            <div class="space-y-4 text-sm text-slate-600">
              <div class="flex items-start gap-x-3">
                <div class="size-8 rounded-lg bg-[#0F1E36] text-[#C8A961] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-[#0F1E36]">Alamat Gedung:</p>
                  <p class="text-xs text-slate-500 leading-relaxed mt-0.5">{firmContact.address}</p>
                </div>
              </div>

              <div class="flex items-start gap-x-3">
                <div class="size-8 rounded-lg bg-[#0F1E36] text-[#C8A961] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-[#0F1E36]">Saluran Telepon:</p>
                  <p class="text-xs text-slate-500 mt-0.5">Kantor: {firmContact.phone}</p>
                  <p class="text-xs text-slate-500">Hotline Darurat: {firmContact.hotline}</p>
                </div>
              </div>

              <div class="flex items-start gap-x-3">
                <div class="size-8 rounded-lg bg-[#0F1E36] text-[#C8A961] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-[#0F1E36]">Jam Operasional Kantor:</p>
                  <p class="text-xs text-slate-500 mt-0.5">{firmContact.operationalHours}</p>
                </div>
              </div>
            </div>

            <!-- WhatsApp Direct Quick Contact -->
            <div class="pt-2">
              <a
                href={`https://wa.me/${firmContact.whatsapp}?text=Halo%20Buslaw,%20saya%20ingin%20berkonsultasi.`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3 px-4 inline-flex justify-center items-center gap-x-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs uppercase tracking-wider transition-colors shadow-xs"
              >
                <span>Chat Langsung WhatsApp Resmi</span>
              </a>
            </div>
          </div>

          <!-- Interactive Map Container (Preline Card) -->
          <div class="flex flex-col bg-white border border-slate-200 shadow-xs rounded-xl p-3 overflow-hidden">
            <div class="relative w-full h-56 rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
              <iframe
                title="Peta Lokasi Kantor Buslaw SCBD"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.273081699946!2d106.80410767573138!3d-6.227681360989069!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f15033878701%3A0x8677c703080ffbe2!2sEquity%20Tower!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="w-full h-full filter contrast-105"
              ></iframe>
            </div>
            <div class="p-2.5 text-center">
              <p class="text-[11px] text-slate-400">Equity Tower Lantai 28, SCBD Jakarta Selatan</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
