---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/common/Button.astro';
import { articles, type Article } from '../../data/articles';
import { lawyers } from '../../data/team';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const author = lawyers.find((l) => l.id === article.authorId);
---

<PageLayout
  title={`${article.title} | BUSLAW & PARTNERS`}
  description={article.excerpt}
  headerTitle={article.title}
  headerSubtitle={`${article.category} • Dipublikasikan pada ${article.publishDate} • ${article.readTime}`}
  breadcrumbs={[
    { label: 'Artikel', href: '/artikel' },
    { label: article.category }
  ]}
>
  <article class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <!-- Feature Image with Preline Card Style -->
      <div class="rounded-2xl overflow-hidden shadow-sm border border-slate-200 bg-slate-900">
        <img
          src={article.image}
          alt={article.title}
          class="w-full h-80 sm:h-96 object-cover"
        />
      </div>

      <!-- Author Bar (Preline Card) -->
      {author && (
        <div class="p-4 rounded-xl bg-[#FAF8F5] border border-slate-200 shadow-2xs flex items-center justify-between">
          <div class="flex items-center gap-x-3">
            <img
              src={author.image}
              alt={author.name}
              class="size-12 rounded-full object-cover border-2 border-[#C8A961]"
            />
            <div>
              <p class="text-xs text-slate-500">Ditulis oleh:</p>
              <h4 class="text-sm font-bold text-[#0F1E36] font-serif">
                <a href={`/tim/${author.id}`} class="hover:text-[#C8A961]">
                  {author.name}
                </a>
              </h4>
              <p class="text-[11px] text-[#B19047] font-semibold">{author.title}</p>
            </div>
          </div>

          <a
            href={`/tim/${author.id}`}
            class="inline-flex items-center gap-x-1 text-xs font-semibold text-[#0F1E36] hover:text-[#C8A961]"
          >
            <span>Profil Penulis</span>
            <span>→</span>
          </a>
        </div>
      )}

      <!-- Article Body -->
      <div class="prose max-w-none text-slate-700 leading-relaxed text-base space-y-6">
        {article.content.map((paragraph) => (
          <p class="text-base sm:text-lg leading-relaxed text-slate-700">
            {paragraph}
          </p>
        ))}
      </div>

      <!-- Consultation Box (Preline Callout Card) -->
      <div class="p-8 rounded-2xl bg-[#0F1E36] text-white border border-[#C8A961]/40 shadow-md space-y-4">
        <span class="inline-flex items-center gap-x-1.5 py-1 px-3 rounded-full text-xs font-medium bg-[#C8A961]/20 text-[#D8BD7E]">
          Bantuan Hukum Terkait
        </span>
        <h3 class="text-2xl font-bold font-serif">
          Menghadapi Situasi Hukum Sebagaimana Dibahas di Atas?
        </h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Konsultasikan dengan tim advokat kami untuk mendapatkan analisa yuridis spesifik terhadap permasalahan perusahaan atau pribadi Anda.
        </p>
        <div class="pt-2">
          <Button href="/kontak" variant="primary" size="md">
            <span>Hubungi Kami untuk Konsultasi</span>
          </Button>
        </div>
      </div>
    </div>
  </article>
</PageLayout>
