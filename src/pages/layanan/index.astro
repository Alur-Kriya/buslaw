---
import PageLayout from '../../layouts/PageLayout.astro';
import { practiceAreas } from '../../data/services';
import { lawyers } from '../../data/team';
---

<PageLayout
  title="Bidang Praktik & Layanan Hukum | BUSLAW & PARTNERS"
  description="Daftar lengkap 6 bidang praktik spesialisasi Buslaw: Korporasi, Litigasi Komersial, Pertanahan, Hubungan Industrial, Pidana Bisnis, dan Hukum Keluarga."
  headerTitle="Bidang Praktik Hukum Kami"
  headerSubtitle="Penanganan profesional dengan spesialisasi mendalam, didukung oleh advokat terkemuka yang siap melindungi kepentingan hukum Anda."
  breadcrumbs={[{ label: 'Layanan Hukum' }]}
>
  <section class="py-20 bg-[#FAF8F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {practiceAreas.map((area, idx) => {
          const leadLawyer = lawyers.find((l) => l.id === area.leadLawyerId);
          const isEven = idx % 2 === 1;

          return (
            <div
              class="flex flex-col bg-white border border-slate-200 shadow-xs rounded-xl p-6 sm:p-10 hover:border-[#C8A961]/70 hover:shadow-md transition-all duration-200"
              data-animate
            >
              <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 items-center ${isEven ? 'lg:flex-row-reverse' : ''}`}>
                <!-- Left Details -->
                <div class="lg:col-span-8 space-y-4">
                  <div class="inline-flex items-center gap-x-2 py-1 px-3 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#C8A961]/15 text-[#B19047] border border-[#C8A961]/30">
                    <span>Praktik 0{idx + 1}</span>
                    <span>•</span>
                    <span>{area.titleEn}</span>
                  </div>

                  <h2 class="text-2xl sm:text-3xl font-bold text-[#0F1E36] font-serif">
                    <a href={`/layanan/${area.slug}`} class="hover:text-[#C8A961] transition-colors">
                      {area.title}
                    </a>
                  </h2>

                  <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                    {area.fullDesc}
                  </p>

                  <!-- Key Scope of Services List -->
                  <div class="pt-2">
                    <p class="text-xs uppercase tracking-wider font-bold text-[#0F1E36] mb-3 font-sans">
                      Ruang Lingkup Penanganan:
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600">
                      {area.servicesList.map((svc) => (
                        <div class="flex items-start gap-x-2">
                          <svg class="size-4 text-[#C8A961] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                          </svg>
                          <span>{svc}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="pt-4 flex items-center gap-x-3">
                    <a
                      href={`/layanan/${area.slug}`}
                      class="py-2.5 px-4 inline-flex items-center gap-x-2 rounded-lg bg-[#0F1E36] hover:bg-[#C8A961] text-white hover:text-[#0F1E36] text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
                    >
                      <span>Lihat Detail Alur & FAQ</span>
                      <span>→</span>
                    </a>

                    <a
                      href="/kontak"
                      class="py-2.5 px-3.5 inline-flex items-center gap-x-1.5 text-xs font-bold text-[#B19047] hover:text-[#0F1E36] transition-colors"
                    >
                      <span>Konsultasi Bidang Ini</span>
                    </a>
                  </div>
                </div>

                <!-- Right Card: Lead Lawyer Info -->
                <div class="lg:col-span-4 bg-[#FAF8F5] rounded-xl p-6 border border-slate-200 text-center flex flex-col items-center">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-3">
                    Pengacara Penanggung Jawab
                  </div>

                  {leadLawyer && (
                    <>
                      <div class="size-20 rounded-full overflow-hidden border-2 border-[#C8A961] shadow-xs mb-3">
                        <img
                          src={leadLawyer.image}
                          alt={leadLawyer.name}
                          class="w-full h-full object-cover object-top"
                        />
                      </div>
                      <h4 class="text-base font-bold text-[#0F1E36] font-serif">
                        <a href={`/tim/${leadLawyer.id}`} class="hover:text-[#C8A961]">
                          {leadLawyer.name}
                        </a>
                      </h4>
                      <p class="text-xs text-[#B19047] font-semibold mt-0.5 mb-2">
                        {leadLawyer.title}
                      </p>
                      <p class="text-xs text-slate-500 line-clamp-2 italic mb-4">
                        "{leadLawyer.quote}"
                      </p>
                      <a
                        href={`/tim/${leadLawyer.id}`}
                        class="text-xs text-[#0F1E36] font-bold hover:underline"
                      >
                        Lihat Profil Pengacara →
                      </a>
                    </>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</PageLayout>
