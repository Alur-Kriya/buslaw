---
import { navItems, firmContact } from '../../data/navigation';
import { practiceAreas } from '../../data/services';
import { lawyers } from '../../data/team';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0A1220] text-slate-300 border-t border-[#C8A961]/25 relative overflow-hidden">
  <!-- Top subtle ambient highlight -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-[#C8A961]/5 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 mb-12">
      <!-- Col 1: Brand & Credentials (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="flex items-center gap-x-3 focus:outline-hidden">
          <div class="size-10 rounded-xl bg-gradient-to-br from-[#C8A961] to-[#8E7130] p-0.5 flex items-center justify-center">
            <div class="w-full h-full bg-[#0F1E36] rounded-[9px] flex items-center justify-center text-[#C8A961]">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="M7 21h10"/>
                <path d="M12 3v18"/>
                <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
              </svg>
            </div>
          </div>
          <div>
            <div class="text-xl font-bold tracking-wider text-white font-serif">BUSLAW</div>
            <div class="text-[10px] tracking-widest text-[#C8A961] uppercase">Advocates & Legal Counsel</div>
          </div>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed">
          {firmContact.slogan}. Kami memberikan solusi hukum berdaya jangkau luas dengan integritas tertinggi untuk korporasi dan perseorangan.
        </p>

        <!-- Preline Badge Group for Accreditations -->
        <div class="pt-3 border-t border-slate-800">
          <div class="text-xs uppercase tracking-wider text-[#C8A961] font-medium mb-2.5">
            Akreditasi & Keanggotaan:
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-md text-xs font-medium bg-slate-900 text-slate-300 border border-slate-800">
              <span class="size-1.5 inline-block rounded-full bg-emerald-500"></span>
              PERADI
            </span>
            <span class="inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-md text-xs font-medium bg-slate-900 text-slate-300 border border-slate-800">
              <span class="size-1.5 inline-block rounded-full bg-[#C8A961]"></span>
              BANI Arbiter
            </span>
            <span class="inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-md text-xs font-medium bg-slate-900 text-slate-300 border border-slate-800">
              <span class="size-1.5 inline-block rounded-full bg-blue-400"></span>
              AKPI Kurator
            </span>
          </div>
        </div>
      </div>

      <!-- Col 2: Practice Areas (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold tracking-wider text-white uppercase font-sans border-b border-slate-800 pb-2.5">
          Bidang Praktik
        </h3>
        <ul class="space-y-2 text-sm">
          {practiceAreas.slice(0, 6).map((service) => (
            <li>
              <a
                href={`/layanan/${service.slug}`}
                class="text-slate-400 hover:text-[#C8A961] transition-colors inline-flex items-center gap-x-1.5 group"
              >
                <span class="text-[#C8A961] opacity-0 group-hover:opacity-100 transition-opacity">›</span>
                <span>{service.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Leadership / Team (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-semibold tracking-wider text-white uppercase font-sans border-b border-slate-800 pb-2.5">
          Tim Pengacara
        </h3>
        <ul class="space-y-2 text-sm">
          {lawyers.map((lawyer) => (
            <li>
              <a
                href={`/tim/${lawyer.id}`}
                class="text-slate-400 hover:text-[#C8A961] transition-colors truncate block"
                title={lawyer.name}
              >
                {lawyer.name.split(',')[0]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact & Office (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-semibold tracking-wider text-white uppercase font-sans border-b border-slate-800 pb-2.5">
          Kantor Utama
        </h3>
        <div class="text-sm text-slate-400 space-y-3 leading-relaxed">
          <p class="flex items-start gap-x-2.5">
            <svg class="size-4 text-[#C8A961] mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-xs">{firmContact.address}</span>
          </p>
          <p class="flex items-center gap-x-2.5">
            <svg class="size-4 text-[#C8A961] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${firmContact.phone.replace(/[^0-9+]/g, '')}`} class="text-xs hover:text-[#C8A961] transition-colors">{firmContact.phone}</a>
          </p>
          <p class="flex items-center gap-x-2.5">
            <svg class="size-4 text-[#C8A961] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${firmContact.email}`} class="text-xs hover:text-[#C8A961] transition-colors">{firmContact.email}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Preline Footer Bottom Bar -->
    <div class="pt-8 border-t border-slate-800/90 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p class="max-w-2xl text-justify md:text-left leading-relaxed">
        <strong>Disclaimer Hukum:</strong> Informasi di website ini disajikan semata untuk tujuan informasi publik dan profil firma, dan tidak dapat ditafsirkan sebagai nasihat hukum formal atau hubungan advokat-klien sebelum adanya penandatanganan Perjanjian Jasa Hukum resmi.
      </p>
      <div class="shrink-0 text-center md:text-right">
        &copy; {currentYear} {firmContact.name}. Hak Cipta Dilindungi Undang-Undang.
      </div>
    </div>
  </div>
</footer>
