---
import MobileNav from './MobileNav';
import { navItems, firmContact } from '../../data/navigation';

interface Props {
  activePath?: string;
}

const { activePath = Astro.url.pathname } = Astro.props;
---

<header class="sticky top-0 z-50 w-full transition-all duration-300">
  <!-- Top Bar for High-Trust Contact & Operating Hours -->
  <div class="hidden lg:block bg-[#0A1220] text-slate-400 text-xs border-b border-slate-800/80 py-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center gap-x-6">
        <span class="inline-flex items-center gap-x-2">
          <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Konsultasi Siap: {firmContact.operationalHours}</span>
        </span>
        <span class="text-slate-700">|</span>
        <span>SCBD Jakarta Selatan</span>
      </div>
      <div class="flex items-center gap-x-6">
        <a href={`tel:${firmContact.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-[#C8A961] transition-colors">
          Telp: {firmContact.phone}
        </a>
        <span class="text-slate-700">|</span>
        <a href={`mailto:${firmContact.email}`} class="hover:text-[#C8A961] transition-colors">
          {firmContact.email}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Preline-Styled Navbar -->
  <nav class="bg-[#0F1E36]/95 backdrop-blur-md border-b border-[#C8A961]/20 shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-x-3 group focus:outline-hidden">
          <div class="size-11 rounded-xl bg-gradient-to-br from-[#C8A961] to-[#8E7130] p-0.5 shadow-sm flex items-center justify-center transition-transform duration-200 group-hover:scale-105">
            <div class="w-full h-full bg-[#0F1E36] rounded-[10px] flex items-center justify-center text-[#C8A961]">
              <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="M7 21h10"/>
                <path d="M12 3v18"/>
                <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
              </svg>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-bold tracking-wider text-white font-serif group-hover:text-[#C8A961] transition-colors">
              BUSLAW
            </span>
            <span class="text-[10px] tracking-widest text-[#C8A961] font-sans uppercase font-medium">
              Advocates & Legal Counsel
            </span>
          </div>
        </a>

        <!-- Desktop Nav Items -->
        <div class="hidden md:flex items-center gap-x-1 lg:gap-x-2">
          {navItems.map((item) => {
            const isActive = activePath === item.href || (item.href !== '/' && activePath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`py-2 px-3.5 inline-flex items-center gap-x-2 text-sm font-medium rounded-lg transition-all duration-200 ${
                  isActive
                    ? 'bg-white/10 text-[#C8A961] shadow-xs'
                    : 'text-slate-200 hover:text-white hover:bg-white/5'
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </div>

        <!-- Right Side CTA & Mobile Island -->
        <div class="flex items-center gap-x-3">
          <a
            href="/kontak"
            class="hidden sm:inline-flex items-center justify-center gap-x-2 py-2.5 px-4 text-sm font-medium rounded-lg border border-transparent bg-[#C8A961] text-[#0F1E36] hover:bg-[#D8BD7E] focus:outline-hidden focus:ring-2 focus:ring-[#C8A961] shadow-xs transition-all duration-200 hover:shadow-md hover:shadow-[#C8A961]/25 cursor-pointer"
          >
            <span>Jadwalkan Konsultasi</span>
            <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <!-- Mobile Nav React Island -->
          <MobileNav client:load />
        </div>
      </div>
    </div>
  </nav>
</header>
