---
import SectionTitle from '../common/SectionTitle.astro';
import { practiceAreas } from '../../data/services';
---

<section class="py-24 bg-[#FAF8F5] relative overflow-hidden" id="layanan">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionTitle
      badge="Keahlian & Bidang Praktik"
      title="Solusi Hukum Menyeluruh untuk Kebutuhan Anda"
      subtitle="Kami menghadirkan keahlian mendalam pada setiap sektor hukum, memadukan analisis yuridis presisi dengan visi strategis bisnis."
      centered={true}
    />

    <!-- Preline UI Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {practiceAreas.map((area, idx) => (
        <div
          class="group flex flex-col justify-between bg-white border border-slate-200 shadow-xs rounded-xl p-6 md:p-8 hover:border-[#C8A961]/70 hover:shadow-md transition-all duration-200"
          data-animate
        >
          <div>
            <!-- Preline Icon Container -->
            <div class="size-12 rounded-xl bg-[#0F1E36] text-[#C8A961] inline-flex justify-center items-center mb-6 group-hover:bg-[#C8A961] group-hover:text-[#0F1E36] transition-colors duration-200 shadow-xs">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {idx === 0 && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                )}
                {idx === 1 && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                )}
                {idx === 2 && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                )}
                {idx === 3 && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                )}
                {idx === 4 && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                )}
                {idx === 5 && (
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                )}
              </svg>
            </div>

            <div class="text-xs text-[#B19047] font-semibold tracking-wider uppercase mb-1.5 font-sans">
              {area.titleEn}
            </div>

            <h3 class="text-xl font-bold text-[#0F1E36] mb-3 group-hover:text-[#C8A961] transition-colors font-serif">
              {area.title}
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed mb-6">
              {area.shortDesc}
            </p>

            <!-- Sample Services Bullet List -->
            <ul class="space-y-2 mb-6 text-xs text-slate-500 border-t border-slate-100 pt-4">
              {area.servicesList.slice(0, 3).map((item) => (
                <li class="flex items-center gap-x-2">
                  <span class="size-1.5 rounded-full bg-[#C8A961] shrink-0"></span>
                  <span class="truncate">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={`/layanan/${area.slug}`}
            class="pt-4 border-t border-slate-100 inline-flex items-center gap-x-1.5 text-xs font-bold uppercase tracking-wider text-[#0F1E36] group-hover:text-[#C8A961] transition-colors"
          >
            <span>Pelajari Selengkapnya</span>
            <svg class="size-4 shrink-0 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
