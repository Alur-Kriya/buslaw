---
import Button from '../common/Button.astro';
import { firmContact } from '../../data/navigation';
---

<section class="py-20 bg-gradient-to-br from-[#0A1220] via-[#0F1E36] to-[#162847] text-white relative overflow-hidden">
  <!-- Gold Ambient Highlight -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-[#C8A961]/15 blur-3xl rounded-full pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-6" data-animate>
    <span class="inline-flex items-center gap-x-2 py-1.5 px-4 rounded-full text-xs font-medium bg-[#C8A961]/15 text-[#D8BD7E] border border-[#C8A961]/30">
      <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Konsultasi Awal Rahasia & Terstruktur</span>
    </span>

    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight font-serif">
      Hadapi Tantangan Hukum Anda Bersama <br />
      <span class="gold-gradient-text">Para Ahli yang Tepat.</span>
    </h2>

    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
      Apakah Anda menghadapi sengketa bisnis bernilai tinggi, membutuhkan audit kepatuhan korporasi, atau memerlukan advokasi mendesak? Tim kami siap mendiskusikan langkah strategis terbaik untuk Anda.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4">
      <Button href="/kontak" variant="primary" size="lg">
        <span>Kirim Rincian Kasus</span>
        <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </Button>

      <a
        href={`https://wa.me/${firmContact.whatsapp}?text=Halo%20Buslaw,%20saya%20ingin%20berkonsultasi.`}
        target="_blank"
        rel="noopener noreferrer"
        class="py-3.5 px-6 inline-flex items-center gap-x-2 text-base font-medium rounded-lg border border-[#C8A961]/50 text-white hover:bg-white/10 focus:outline-hidden transition-colors"
      >
        <svg class="size-5 text-emerald-400 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Hubungi WhatsApp Kantor</span>
      </a>
    </div>

    <p class="text-xs text-slate-400 pt-4">
      Layanan kami menghormati sepenuhnya ketentuan kerahasiaan hubungan Advokat dan Klien (UU No. 18 Tahun 2003).
    </p>
  </div>
</section>
