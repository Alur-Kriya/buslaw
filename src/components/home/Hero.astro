---
import Button from '../common/Button.astro';
---

<section class="relative bg-[#0F1E36] text-white pt-16 pb-24 lg:pt-24 lg:pb-32 overflow-hidden">
  <!-- Background Image with Dark Elegant Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=1600"
      alt="Buslaw Law Firm Office"
      class="w-full h-full object-cover object-center opacity-15 filter brightness-50"
      loading="eager"
    />
    <!-- Gradient wash -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0A1220] via-[#0F1E36]/95 to-[#0F1E36]/85"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#C8A961_1px,transparent_1px)] [background-size:32px_32px] opacity-10"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Column: Copywriting -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Preline Announcement Badge -->
        <div>
          <a
            href="/tentang-kami"
            class="inline-flex items-center gap-x-2 py-1.5 px-4 rounded-full text-xs font-medium bg-[#C8A961]/15 text-[#D8BD7E] border border-[#C8A961]/30 hover:bg-[#C8A961]/25 transition-colors focus:outline-hidden"
          >
            <span class="size-2 rounded-full bg-[#C8A961] animate-ping"></span>
            <span>Advokasi Hukum Terpercaya Sejak 2008</span>
            <svg class="size-3.5 shrink-0 text-[#C8A961]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]">
          Melindungi Hak & <br class="hidden sm:inline" />
          <span class="gold-gradient-text">Mengawal Kepastian</span> <br class="hidden sm:inline" />
          Hukum Bisnis Anda.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed font-sans font-normal">
          Firma hukum terkemuka di Jakarta yang didukung oleh 6 advokat berdedikasi tinggi dengan keahlian komprehensif pada hukum korporasi, litigasi komersial, agraria, hingga mitigasi tindak pidana korporasi.
        </p>

        <!-- Preline Button Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <Button href="/kontak" variant="primary" size="lg">
            <span>Konsultasi Kasus Anda</span>
            <svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </Button>

          <Button href="/layanan" variant="outline" size="lg">
            <span>Eksplorasi Bidang Praktik</span>
          </Button>
        </div>

        <!-- Preline Trust Badges Row -->
        <div class="pt-6 border-t border-slate-700/60 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-slate-300">
          <div class="inline-flex items-center gap-x-2 py-1.5 px-3 rounded-lg bg-white/5 border border-white/5">
            <svg class="size-4 text-[#C8A961] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span>100% Kerahasiaan Klien</span>
          </div>
          <div class="inline-flex items-center gap-x-2 py-1.5 px-3 rounded-lg bg-white/5 border border-white/5">
            <svg class="size-4 text-[#C8A961] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Respon Cepat 24 Jam</span>
          </div>
          <div class="inline-flex items-center gap-x-2 py-1.5 px-3 rounded-lg bg-white/5 border border-white/5">
            <svg class="size-4 text-[#C8A961] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Lisensi PERADI & BANI</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Managing Partner Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Preline Styled Card -->
          <div class="relative rounded-2xl overflow-hidden border border-[#C8A961]/30 shadow-2xl bg-[#0A1220]">
            <img
              src="/images/team/bambang-sudirman.jpg"
              alt="Managing Partner Dr. Bambang Sudirman"
              class="w-full h-96 lg:h-[460px] object-cover object-top filter brightness-95 transition-transform duration-700 hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0A1220] via-transparent to-transparent opacity-90"></div>

            <!-- Card Bottom Bar -->
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#0F1E36]/90 backdrop-blur-md border border-[#C8A961]/30 shadow-lg">
              <div class="flex items-center justify-between">
                <div>
                  <span class="inline-flex items-center gap-x-1 py-0.5 px-2 rounded-md text-[11px] font-semibold tracking-wider uppercase bg-[#C8A961]/20 text-[#D8BD7E]">
                    Managing Partner
                  </span>
                  <p class="text-base font-bold text-white font-serif mt-1">
                    Dr. Bambang Sudirman, S.H., M.H.
                  </p>
                </div>
                <div class="size-10 rounded-full bg-[#C8A961]/20 border border-[#C8A961] flex items-center justify-center text-[#C8A961]">
                  <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
