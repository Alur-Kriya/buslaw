---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import WhatsAppFloat from '../components/common/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  headerTitle?: string;
  headerSubtitle?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description,
  headerTitle,
  headerSubtitle,
  breadcrumbs,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="flex-grow">
    {headerTitle && (
      <section class="relative bg-[#0F1E36] text-white py-16 lg:py-20 overflow-hidden border-b border-[#C8A961]/20">
        <!-- Subtle background pattern & glow -->
        <div class="absolute inset-0 bg-[radial-gradient(#C8A961_1px,transparent_1px)] [background-size:28px_28px] opacity-10 pointer-events-none"></div>
        <div class="absolute -top-24 right-0 w-96 h-96 bg-[#C8A961]/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          {breadcrumbs && (
            <nav class="flex items-center space-x-2 text-xs text-slate-400 mb-4 font-sans">
              <a href="/" class="hover:text-[#C8A961] transition-colors">Beranda</a>
              {breadcrumbs.map((crumb) => (
                <>
                  <span class="text-slate-600">/</span>
                  {crumb.href ? (
                    <a href={crumb.href} class="hover:text-[#C8A961] transition-colors">{crumb.label}</a>
                  ) : (
                    <span class="text-[#C8A961] font-medium">{crumb.label}</span>
                  )}
                </>
              ))}
            </nav>
          )}

          <div class="max-w-3xl">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
              {headerTitle}
            </h1>
            {headerSubtitle && (
              <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
                {headerSubtitle}
              </p>
            )}
          </div>
        </div>
      </section>
    )}

    <slot />
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>

